# Vision 5D Configuration
V5D_DATABASE_URL=sqlite:///./vision5d.db
V5D_ENCRYPTION_KEY=change-me-in-production-32-bytes-min
V5D_API_PORT=8000
V5D_WORKER_POLL_INTERVAL=2

# AI Providers
GEMINI_API_KEY=
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Veo 3.1 video generation (veo3api.com)
# veo3-fast = 25 credits ($0.25) / clip, veo3 = 180 credits ($1.80) / clip
VEO_API_KEY=
VEO_BASE_URL=https://veo3api.com
VEO_MODEL=veo3-fast
